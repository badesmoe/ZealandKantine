@page
@model ZealandKantine.Pages.Analysis.IndexModel
@{
    ViewData["Title"] = "Salgstal";
}
<h1>Salgtal</h1>

<h2>Menupunkter</h2>
@foreach (var menuItem in Model.SoldMenuItems)
{
    <div class="menu-category">
        <p>Navn: @menuItem.MenuItem.Name</p>
        <p>Antal: @menuItem.TotalSold</p>
    </div>
}

<h2>Dagens Ret</h2>
@foreach (var dailySpecial in Model.SoldDailySpecials)
{
    <div class="menu-category">
        <p>Navn: @dailySpecial.DailySpecial.Description</p>
        <p>Antal: @dailySpecial.TotalSold</p>
    </div>
}

<h2>Omsætning pr. dag</h2>

<form method="get" class="filter-form">
    <div class="form-group">
        <label for="startDate">Fra dato:</label>
        <input type="date" id="startDate" name="startDate"
               value="@Model.StartDate.ToString("yyyy-MM-dd")"
               onchange="updateEndDateMin()" />
    </div>
    <div class="form-group">
        <label for="endDate">Til dato:</label>
        <input type="date" id="endDate" name="endDate"
               value="@Model.EndDate.ToString("yyyy-MM-dd")"
               min="@Model.StartDate.ToString("yyyy-MM-dd")" />
    </div>
    <button type="submit" class="btn btn-primary">Filtrer</button>
</form>

<script>
    function updateEndDateMin() {
        const startDate = document.getElementById('startDate').value;
        const endDateInput = document.getElementById('endDate');

        endDateInput.min = startDate;

        // If endDate is now before startDate, reset it
        if (endDateInput.value < startDate) {
            endDateInput.value = startDate;
        }
    }
</script>

@foreach (var revenue in Model.RevenueByDate)
{
    <div class="menu-category">
        <p>Dato: @revenue.Date.ToString("dd/MM/yyyy")</p>
        <p>Omsætning: @revenue.TotalRevenue.ToString("C")</p>
    </div>
}

<p>Samlet omsætning: @Model.TotalRevenue.ToString("C")</p>