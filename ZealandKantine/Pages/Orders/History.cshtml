@page "/orders/history"
@model ZealandKantine.Pages.Orders.HistoryModel

<h1>Mine Tidligere Køb</h1>

<form method="get" class="mb-4 d-flex gap-2">

    <input type="text"
           name="SearchTerm"
           value="@Model.SearchTerm"
           class="form-control"
           placeholder="Søg efter ordre eller status..." />

    <select name="PeriodFilter" class="form-select">

        <option value="">Alle</option>

        <option value="thismonth">
            Denne måned
        </option>

        <option value="lastmonth">
            Sidste måned
        </option>

    </select>

    <button type="submit"
            class="btn btn-primary">

        Søg

    </button>

</form>

<div class="mb-4 d-flex gap-2">

    <a class="btn @(Model.ViewMode == "cards" || string.IsNullOrEmpty(Model.ViewMode)
               ? "btn-primary"
               : "btn-outline-primary")"
       href="?ViewMode=cards"
       title="Kortvisning">

        <i class="bi bi-grid-3x3-gap-fill"></i>

    </a>

    <a class="btn @(Model.ViewMode == "list"
               ? "btn-primary"
               : "btn-outline-primary")"
       href="?ViewMode=list"
       title="Listevisning">

        <i class="bi bi-list-ul"></i>

    </a>

</div>

@if (Model.Orders.Count == 0)
{
    <p>Ingen tidligere køb fundet.</p>
}
else
{
    @if (Model.ViewMode == "list")
    {
        <table class="table">

            <thead>
                <tr>
                    <th>Ordre</th>
                    <th>Dato</th>
                    <th>Status</th>
                    <th>Total</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var order in Model.Orders)
                {
                    <tr>

                        <td>#@order.Id</td>

                        <td>
                            @order.OrderDateTime.ToString("dd/MM/yyyy")
                        </td>

                        <td>@order.Status</td>

                        <td>@order.NetTotal kr</td>

                    </tr>
                }

            </tbody>

        </table>
    }
    else
    {
        @foreach (var order in Model.Orders)
        {
            <div class="card mb-4 shadow-sm border-0">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>
                            <h4>Ordre #@order.Id</h4>

                            <p class="text-muted">
                                @order.OrderDateTime.ToString("dd/MM/yyyy HH:mm")
                            </p>
                        </div>

                        <div>

                            @if (order.Status == "Modtaget")
                            {
                                <span class="badge bg-warning text-dark">
                                    Modtaget
                                </span>
                            }

                            @if (order.Status == "Tilberedes")
                            {
                                <span class="badge bg-info">
                                    Tilberedes
                                </span>
                            }

                            @if (order.Status == "Klar")
                            {
                                <span class="badge bg-success">
                                    Klar
                                </span>
                            }

                            @if (order.Status == "Afhentet")
                            {
                                <span class="badge bg-secondary">
                                    Afhentet
                                </span>
                            }

                        </div>

                    </div>

                    <hr />

                    <h5>Produkter</h5>

                    <ul>
                        @foreach (var line in order.OrderLines)
                        {
                            <li>
                                @(line.MenuItem?.Name ??
                                                line.DailySpecial?.Description)

                x @line.Quantity
            </li>
                        }
                    </ul>

                    <hr />

                    <h5>
                        Total:
                        <strong>@order.NetTotal kr</strong>
                    </h5>

                </div>

            </div>
        }
    }
}