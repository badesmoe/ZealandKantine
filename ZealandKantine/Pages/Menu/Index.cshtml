@page
@model ZealandKantine.Pages.Menu.IndexModel
@section Styles
{
    <style>
        .menu-item 
        {
            transition: none;
            padding: 1.2rem;
        }

            .menu-item:hover 
            {
                border-color: var(--cz-border);
                box-shadow: none;
                transform: none;
                outline: none;
            }

        .menu-list 
        {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

            .menu-list .menu-category 
            {
                width: 100%;
            }

            .menu-list .menu-item 
            {
                display: flex;
                justify-content: space-between;
                align-items: center;
                border: 1px solid #ddd;
                border-radius: 12px;
                padding: 1rem;
                margin-bottom: 1rem;
                background-color: white;
            }

            .menu-list .menu-item__category 
            {
                min-width: 120px;
            }

            .menu-list .menu-item__name 
            {
                flex-grow: 1;
                margin: 0 1rem;
            }

            .menu-list .menu-item__price 
            {
                font-weight: bold;
                margin: 0;
            }

        .menu-list 
        {
            display: flex;
            flex-direction: column;
            gap: 1rem;
            width: 100%;
        }

        .menu-list-item 
        {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1rem 1.5rem;
            border: 1px solid var(--cz-border);
            border-radius: 16px;
            background-color: white;
            margin-bottom: 0.8rem;
            box-shadow: 0 2px 6px rgba(0,0,0,0.04);
        }

        .menu-list-item-left {
            display: flex;
            flex-direction: column;
            gap: 0.3rem;
        }

        .menu-list-item-name {
            font-size: 1.05rem;
            font-weight: 600;
            color: #222;
        }

        .menu-list-item .menu-item__category {
            width: fit-content;
        }

            
    </style>
}
@{
    ViewData["Title"] = "Menu";
}



<h1>Menu</h1>
@if (Model.TodaysSpecial != null)
{
    <div class="daily-special">

        <h2>Dagens Ret</h2>

        <p>
            @Model.TodaysSpecial.Description
        </p>

        <div class="daily-special-price">
            @Model.TodaysSpecial.Price kr.
        </div>

    </div>
}

<div class="mb-4 d-flex gap-2">

    <a class="btn @(Model.ViewMode == "cards" || string.IsNullOrEmpty(Model.ViewMode)
                             ? "btn-primary"
                             : "btn-outline-primary")"
       href="?ViewMode=cards"
       title="Kortvisning">

        <i class="bi bi-grid-3x3-gap-fill"></i>

    </a>

    <a class="btn @(Model.ViewMode == "list"
                             ? "btn-primary"
                             : "btn-outline-primary")"
       href="?ViewMode=list"
       title="Listevisning">

        <i class="bi bi-list-ul"></i>

    </a>

</div>


@if (Model.ViewMode == "cards")
{
    <div class="menu-grid">

        @foreach (var group in Model.Items.GroupBy(m => m.Category))
        {
            <div class="menu-category">

                <h2>@group.Key</h2>

                @foreach (var item in group)
                {
                    <div class="menu-item">

                        <span class="menu-item__category">
                            @item.Category
                        </span>

                        <h3 class="menu-item__name">
                            @item.Name
                        </h3>

                        <p class="menu-item__price">
                            @item.Price.ToString("0.00") 
                        </p>

                    </div>
                }

            </div>
        }

    </div>
}
else
{
    <div class="menu-list">

        @foreach (var item in Model.Items)
        {
            <div class="menu-list-item">

                <div>
                    <span class="menu-item__category">
                        @item.Category
                    </span>

                    <strong class="ms-2">
                        @item.Name
                    </strong>
                </div>

                <div class="fw-bold">
                    @item.Price.ToString("0.00") kr
                </div>

            </div>
        }

    </div>

    <div class="mb-5"></div>
}